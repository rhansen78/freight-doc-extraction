__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# Eval outputs are regenerated from a seed; only checked-in reference runs live
# in evals/results/, and those are added deliberately.
evals/results/*.json
!evals/results/heldout_*.json

# Never commit an API key.
.env
.env.*

# Failed venv attempt parked here; device shell cannot unlink in this mount.
_to_delete/
_to_delete_venv/

# Stale git locks parked here (mount forbids unlink).
.gitlocks/
